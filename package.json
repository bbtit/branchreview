{
  "name": "sidediff",
  "displayName": "SideDiff",
  "version": "0.0.1",
  "private": true,
  "description": "Codebase-aware PR review: PR branch code in the normal editor, diff as gutter metadata.",
  "categories": [
    "Other"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bbtit/sidediff.git"
  },
  "publisher": "bbtit",
  "type": "module",
  "main": "./dist/extension.cjs",
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "test": "vp test",
    "watch": "vp pack --watch",
    "vscode:prepublish": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/vscode": "^1.96.0",
    "typescript": "^5.8.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "contributes": {
    "commands": [
      {
        "command": "sidediff.setBase",
        "title": "SideDiff: Set Base"
      },
      {
        "command": "sidediff.resumeReview",
        "title": "SideDiff: Resume Review"
      },
      {
        "command": "sidediff.stopReview",
        "title": "SideDiff: Stop Review"
      },
      {
        "command": "sidediff.clearBase",
        "title": "SideDiff: Clear Base"
      },
      {
        "command": "sidediff.clearReviewProgress",
        "title": "SideDiff: Clear All Review Progress for This Repository"
      },
      {
        "command": "sidediff.nextChange",
        "title": "SideDiff: Next Change"
      },
      {
        "command": "sidediff.previousChange",
        "title": "SideDiff: Previous Change"
      },
      {
        "command": "sidediff.showGitContext",
        "title": "SideDiff: Show Git Context"
      },
      {
        "command": "sidediff.openTreeFile",
        "title": "SideDiff: Open Changed File"
      },
      {
        "command": "sidediff.markReviewed",
        "title": "SideDiff: Mark as Reviewed"
      },
      {
        "command": "sidediff.markUnreviewed",
        "title": "SideDiff: Mark as Unreviewed"
      }
    ],
    "keybindings": [
      {
        "command": "sidediff.nextChange",
        "key": "alt+]",
        "mac": "alt+]",
        "when": "editorTextFocus && !isInDiffEditor"
      },
      {
        "command": "sidediff.previousChange",
        "key": "alt+[",
        "mac": "alt+[",
        "when": "editorTextFocus && !isInDiffEditor"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sidediff",
          "title": "SideDiff",
          "icon": "media/sidediff-activity.svg"
        }
      ]
    },
    "views": {
      "sidediff": [
        {
          "id": "sidediff.changes",
          "name": "Changes"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "sidediff.openTreeFile",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "sidediff.markReviewed",
          "when": "view == sidediff.changes && viewItem =~ /^sidediff\\.file(\\.(binary|deleted))?$/",
          "group": "1_review@1"
        },
        {
          "command": "sidediff.markUnreviewed",
          "when": "view == sidediff.changes && viewItem =~ /^sidediff\\.file(\\.(binary|deleted))?\\.reviewed$/",
          "group": "1_review@1"
        }
      ]
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "10.25.0",
      "onFail": "download"
    }
  },
  "engines": {
    "vscode": "^1.96.0"
  }
}
